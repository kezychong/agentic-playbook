diff --git a/apps/desktop/electron/talk-auth.test.ts b/apps/desktop/electron/talk-auth.test.ts
new file mode 100644
--- /dev/null
+++ b/apps/desktop/electron/talk-auth.test.ts
@@ -0,0 +1,27 @@
+import { describe, expect, it } from 'vitest'
+import { DesktopTalkAuth } from './talk-auth'
+
+describe('native Talk authentication', () => {
+  it('grants only owned local Talk routes and retires the exited child', () => {
+    const auth = new DesktopTalkAuth()
+    const local = { baseUrl: 'http://127.0.0.1:1234', mode: 'local' }
+    const revoke = auth.register(local.baseUrl, 'temporary')
+    expect(auth.headers(local, '/api/plugins/hermes-talk/status')).toEqual({
+      'x-hermes-desktop-talk-token': 'temporary'
+    })
+    expect(auth.headers(local, '/api/plugins/other/status')).toEqual({})
+    expect(auth.headers({ ...local, mode: 'remote' }, '/api/plugins/hermes-talk/status')).toEqual({})
+    revoke()
+    expect(auth.headers(local, '/api/plugins/hermes-talk/status')).toEqual({})
+  })
+  it('cannot register a remote host or retire a replacement credential', () => {
+    const auth = new DesktopTalkAuth()
+    expect(() => auth.register('http://example.com', 'secret')).toThrow('loopback')
+    const old = auth.register('http://127.0.0.1:1234', 'old')
+    auth.register('http://127.0.0.1:1234', 'new')
+    old()
+    expect(
+      auth.headers({ baseUrl: 'http://127.0.0.1:1234', mode: 'local' }, '/api/plugins/hermes-talk/status')
+    ).toEqual({ 'x-hermes-desktop-talk-token': 'new' })
+  })
+})
diff --git a/apps/desktop/electron/talk-auth.ts b/apps/desktop/electron/talk-auth.ts
new file mode 100644
--- /dev/null
+++ b/apps/desktop/electron/talk-auth.ts
@@ -0,0 +1,18 @@
+/** Main-process-only credentials. Never exported through the preload bridge. */
+export class DesktopTalkAuth {
+  private readonly owned = new Map<string, string>()
+
+  register(baseUrl: string, token: string): () => void {
+    if (new URL(baseUrl).hostname !== '127.0.0.1') throw new Error('Talk backend must be loopback')
+    this.owned.set(baseUrl, token)
+    return () => {
+      if (this.owned.get(baseUrl) === token) this.owned.delete(baseUrl)
+    }
+  }
+
+  headers(descriptor: { baseUrl: string; mode?: string }, path: string): Record<string, string> {
+    if (descriptor.mode !== 'local' || !path.startsWith('/api/plugins/hermes-talk/')) return {}
+    const token = this.owned.get(descriptor.baseUrl)
+    return token ? { 'x-hermes-desktop-talk-token': token } : {}
+  }
+}
