 const ComposerVoiceControllerContext = createContext<ComposerVoiceController | null>(null)
 
+export function releaseComposerVoiceLeases(leases: Set<ComposerVoiceLease>): void {
+  for (const lease of leases) lease.release()
+  leases.clear()
+}
+
+export function useComposerVoiceLifetime(epoch: number): AbortController {
+  // Epoch is an ownership boundary, not a cosmetic memo dependency. The
+  // compiler otherwise hoists the signal because its constructor reads no epoch.
+  'use no memo'
+  const lifetime = useMemo(() => new AbortController(), [epoch])
+  const mount = useRef({ generation: 0, lifetime })
+  useLayoutEffect(() => {
+    const generation = ++mount.current.generation
+    mount.current.lifetime = lifetime
+    return () => {
+      // A replayed cleanup/setup is not an unmount. A real unmount or
+      // replaced conversation still aborts before the next task runs.
+      queueMicrotask(() => {
+        if (mount.current.generation === generation || mount.current.lifetime !== lifetime) lifetime.abort()
+      })
+    }
+  }, [lifetime])
+  return lifetime
+}
+
 export function useComposerVoiceController(): ComposerVoiceController | null {
   return useContext(ComposerVoiceControllerContext)
 }
