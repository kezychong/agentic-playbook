+"""Task ownership comes from verified auth and the exact bound profile."""
+import time
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+from fastapi import HTTPException
+from starlette.requests import Request
+from hermes_cli.dashboard_auth.base import Session
+
+
+@pytest.fixture
+def home(tmp_path, monkeypatch):
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    root = tmp_path / ".hermes"
+    primary = root / "profiles" / "primary"
+    primary.mkdir(parents=True)
+    (primary / "config.yaml").write_text("model: test\n")
+    monkeypatch.setenv("HERMES_HOME", str(primary))
+    return primary
+
+
+def request(session=None, headers=(), query=b""):
+    value = Request({"type": "http", "path": "/api/plugins/hermes-talk/status", "headers": list(headers),
+                     "query_string": query, "app": SimpleNamespace(state=SimpleNamespace(auth_required=True))})
+    if session is not None:
+        value.state.session = session
+    return value
+
+
+def session():
+    return Session("user-a", "", "", "org-a", "nous", int(time.time()) + 100, "secret", "secret-refresh")
+
+
+def test_verified_session_binds_exact_profile_and_stable_identity(home):
+    from hermes_cli.dashboard_task_context import resolve_dashboard_task_context
+    first = resolve_dashboard_task_context(request(session()), profile="primary")
+    second = resolve_dashboard_task_context(request(session()), profile="primary")
+    assert first == second
+    assert first.profile_home == home.resolve()
+    assert first.profile_name == "primary"
+    assert first.principal_kind == "session"
+    assert "secret" not in first.principal_id + first.store_id
+
+
+@pytest.mark.parametrize("profile", [None, "primary", "../primary", "/tmp", "default", "eve"])
+def test_unverified_headers_cannot_authorize_any_profile(home, profile):
+    from hermes_cli.dashboard_task_context import resolve_dashboard_task_context
+    with pytest.raises(HTTPException) as denied:
+        resolve_dashboard_task_context(request(headers=[(b"x-principal-id", b"owner")]), profile=profile)
+    assert denied.value.status_code == 401
+
+
+@pytest.mark.parametrize("profile", ["../primary", "/tmp", "eve"])
+def test_verified_session_cannot_escape_bound_profile(home, profile):
+    from hermes_cli.dashboard_task_context import resolve_dashboard_task_context
+    with pytest.raises(HTTPException) as denied:
+        resolve_dashboard_task_context(request(session()), profile=profile)
+    assert denied.value.status_code == 403
+
+
+def test_default_backend_can_select_live_primary_without_inheriting_home(home, monkeypatch):
+    from hermes_cli.dashboard_task_context import resolve_dashboard_task_context
+    monkeypatch.setenv("HERMES_HOME", str(home.parent.parent))
+    value = request(session(), query=b"profile=primary")
+    context = resolve_dashboard_task_context(value, profile="primary")
+    assert context.profile_name == "primary"
+    assert context.profile_home == home.resolve()
+    with pytest.raises(HTTPException) as denied:
+        resolve_dashboard_task_context(value, profile="default")
+    assert denied.value.status_code == 403
+
+
+def test_symlink_cannot_escape_server_profile_root(home, tmp_path):
+    from hermes_cli.dashboard_task_context import resolve_dashboard_task_context
+    outside = tmp_path / "outside"
+    outside.mkdir()
+    (outside / "config.yaml").write_text("model: test\n")
+    (home.parent / "escape").symlink_to(outside)
+    with pytest.raises(HTTPException) as denied:
+        resolve_dashboard_task_context(request(session()), profile="escape")
+    assert denied.value.status_code == 403
+
+
+def test_local_desktop_requires_canonical_session_token(home, monkeypatch):
+    from hermes_cli import web_server
+    from hermes_cli.dashboard_task_context import resolve_dashboard_task_context
+    monkeypatch.setattr(web_server, "_SESSION_TOKEN", "verified-local-secret")
+    value = request(headers=[(b"authorization", b"Bearer verified-local-secret")])
+    value.app.state.auth_required = False
+    context = resolve_dashboard_task_context(value, profile="primary")
+    assert context.principal_kind == "desktop"
+    assert "verified-local-secret" not in repr(context)
+    forged = request(headers=[(b"authorization", b"Bearer forged")])
+    forged.app.state.auth_required = False
+    with pytest.raises(HTTPException) as denied:
+        resolve_dashboard_task_context(forged, profile="primary")
+    assert denied.value.status_code == 401
+
+
+def test_expired_session_and_flag_without_verified_token_are_rejected(home):
+    from hermes_cli.dashboard_task_context import resolve_dashboard_task_context
+    expired = Session("user", "", "", "", "nous", 1, "at", "rt")
+    value = request(expired)
+    value.state.token_authenticated = True
+    value.state.token_principal = SimpleNamespace(principal="forged", provider="forged")
+    with pytest.raises(HTTPException) as denied:
+        resolve_dashboard_task_context(value, profile="primary")
+    assert denied.value.status_code == 401
