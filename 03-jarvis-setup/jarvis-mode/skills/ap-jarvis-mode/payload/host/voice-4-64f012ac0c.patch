+"""Verified dashboard caller and exact profile ownership for task integrations.
+
+Identity headers are never authority. OAuth/native sessions come from the
+existing auth middleware; local desktop tokens use its canonical verifier.
+"""
+from dataclasses import dataclass, field
+import hashlib
+import json
+from pathlib import Path
+import time
+
+from fastapi import HTTPException
+from hermes_cli.dashboard_auth.base import Session
+from hermes_constants import get_hermes_home, get_default_hermes_root
+
+
+@dataclass(frozen=True, slots=True)
+class DashboardTaskContext:
+    principal_id: str
+    principal_kind: str
+    profile_name: str
+    profile_home: Path = field(repr=False)
+    store_id: str = field(repr=False)
+
+
+def _digest(parts):
+    return hashlib.sha256(json.dumps(parts, separators=(",", ":")).encode()).hexdigest()
+
+
+def _principal(request):
+    session = getattr(request.state, "session", None)
+    if isinstance(session, Session) and session.user_id and session.provider and session.expires_at > time.time():
+        return "session", _digest(["session", session.provider, session.org_id, session.user_id])
+    if not getattr(request.app.state, "auth_required", False):
+        from hermes_cli import web_server
+        if web_server._has_valid_session_token(request):
+            return "desktop", _digest(["desktop", web_server._SESSION_TOKEN])
+    raise HTTPException(status_code=401, detail="Unauthorized")
+
+
+def resolve_dashboard_task_context(request, *, profile=None):
+    """Mirror authenticated dashboard profile management, with exact store binding.
+
+    Dashboard identities already manage all live profiles under this server's
+    root. Explicit query/argument disagreement is denied rather than letting a
+    cached task integration silently authorize a different requested store.
+    """
+    kind, principal = _principal(request)
+    from hermes_cli.profiles import get_profile_dir, normalize_profile_name, profile_exists, validate_profile_name
+    root = get_default_hermes_root().resolve(strict=True)
+    current_home = get_hermes_home().resolve(strict=True)
+    current = "default" if current_home == root else current_home.name
+    query = request.query_params.get("profile")
+    if profile is not None and query is not None and profile != query:
+        raise HTTPException(status_code=403, detail="Profile denied")
+    selected = profile if profile is not None else query if query is not None else current
+    if not isinstance(selected, str) or not selected or normalize_profile_name(selected) != selected:
+        raise HTTPException(status_code=403, detail="Profile denied")
+    try:
+        validate_profile_name(selected)
+        if not profile_exists(selected):
+            raise ValueError("Profile missing")
+        home = get_profile_dir(selected).resolve(strict=True)
+        expected = root if selected == "default" else root / "profiles" / selected
+        if expected.resolve(strict=True) != home or not home.is_dir():
+            raise ValueError("Profile outside server root")
+        home.relative_to(root)
+    except (OSError, RuntimeError, ValueError):
+        raise HTTPException(status_code=403, detail="Profile denied") from None
+    return DashboardTaskContext(principal, kind, selected, home, _digest(["store", str(home)]))
diff --git a/tests/hermes_cli/test_dashboard_task_context.py b/tests/hermes_cli/test_dashboard_task_context.py
