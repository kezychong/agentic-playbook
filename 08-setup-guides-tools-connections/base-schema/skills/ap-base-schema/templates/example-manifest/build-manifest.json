      "on_fail": "stop_and_report",
      "stop_for_owner": false
    },
    {
      "id": "CP4",
      "title": "First hand import",
      "kind": "import_by_hand",
      "steps": [
        "Ask the Accounts lead for the paid-bill export, and the Compliance lead for the licence details from the public register.",
        "Make sure the export covers the two real records CP5 will use.",
        "Import through the import step only; every row is labelled imported_by_hand with the export's date.",
        "Report new rows, changed values and rejected duplicates."
      ],
      "readback": [
        {
          "check": "owner_confirms",
          "target": "new rows, changed values and rejected lines for each export file",
          "expect": "they match the export file"
        },
        {
          "check": "owner_confirms",
          "target": "SELECT * FROM unmatched_bills",
          "expect": "each bill is fixed in its home or accepted as unmatched"
        }
      ],
      "on_fail": "stop_and_report",
      "stop_for_owner": true
    },
    {
      "id": "CP5",
      "title": "Two real records",
      "kind": "acceptance_real",
      "steps": [
        "Ask the owner for one past deadline that went smoothly and one that went wrong.",
