      "on_fail": "stop_and_report",
      "stop_for_owner": true
    },
    {
      "id": "CP6",
      "title": "Finish",
      "kind": "finish",
      "steps": [
        "Write build-status.json: every checkpoint done with its readback matched.",
        "State each route honestly: a hand import is step 2 at most.",
        "Keep the backup."
