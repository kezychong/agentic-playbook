{
  "theme": "Studio",
  "owner_label": "project owner",
  "project_label": "current project",
  "state_labels": {
    "done": "done",
    "in_progress": "in progress",
    "blocked": "blocked",
    "next": "next",
    "unanswered": "Unanswered"
  },
  "storage": {
    "page_folder": "review-pages",
